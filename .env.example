#################################################################
##  SCANNER MAP CONFIGURATION (.env)                            ##
##                                                             ##
##  You usually do NOT need to edit this by hand.              ##
##  On first run, open the web Setup Wizard at:               ##
##     http://localhost:8080/setup                            ##
##  and it will generate this file for you.                   ##
#################################################################


#################################################################
##                 CORE / RUNTIME                              ##
#################################################################

# Set to true to skip the web setup wizard (advanced users editing by hand).
SETUP_COMPLETE=false

# Run without Discord (pure web-map mode). When true, DISCORD_TOKEN is optional.
MAP_ONLY_MODE=false


#################################################################
##                   DISCORD BOT SETTINGS                      ##
#################################################################

DISCORD_TOKEN=
CLIENT_ID=


#################################################################
##                 SERVER & NETWORK SETTINGS                   ##
#################################################################

# Port for SDRTrunk/TrunkRecorder/rdio-scanner uploads
BOT_PORT=3306

# Port for the web interface / API server
WEBSERVER_PORT=80

# Public domain or IP used for generating playback/share links.
# Leave blank for local use (it defaults to http://localhost:<WEBSERVER_PORT>).
# Set it only for remote/public access, including the scheme, e.g.
#   https://scanner.example.com   or   http://192.168.1.50:8080
PUBLIC_DOMAIN=

# Timezone (IANA format, e.g. "America/New_York")
TIMEZONE=America/New_York


#################################################################
##              AUTHENTICATION & API KEY SETTINGS              ##
#################################################################

API_KEY_FILE=data/apikeys.json

# Enable password protection on the web interface
ENABLE_AUTH=false
WEBSERVER_PASSWORD=changeme

# Secret used to sign sessions (auto-generated by the setup wizard)
SESSION_SECRET=
SESSION_DURATION_DAYS=7
MAX_SESSIONS_PER_USER=5


#################################################################
##                  AUDIO STORAGE SETTINGS                     ##
#################################################################

# Storage backend for call audio.
# Options:
#   local   - store audio files on disk (./audio)
#   s3      - Amazon S3
#   r2      - Cloudflare R2 (S3-compatible)
#   b2      - Backblaze B2 (S3-compatible)
#   minio   - self-hosted MinIO (S3-compatible)
#   db      - store audio as BLOBs inside SQLite (legacy, not recommended)
STORAGE_MODE=local

# Local storage
LOCAL_AUDIO_DIR=audio

# --- S3-compatible settings (used by s3 / r2 / b2 / minio) ---
# For Cloudflare R2: endpoint is https://<accountid>.r2.cloudflarestorage.com  and region "auto"
# For Backblaze B2:  endpoint is https://s3.<region>.backblazeb2.com
# For MinIO:         endpoint is your server, e.g. http://localhost:9000
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Force path-style URLs (required for MinIO and some B2 setups)
S3_FORCE_PATH_STYLE=false
# Optional public base URL for objects (e.g. an R2 public bucket or CDN domain).
# If set, audio is served via this URL; otherwise the app proxies/serves it.
S3_PUBLIC_BASE_URL=

# When remote storage (s3/r2/b2/minio) is unreachable: retry, then save the
# audio locally and keep processing the call. A maintenance job re-uploads the
# local copies every STORAGE_RETRY_INTERVAL_MIN and deletes them once uploaded.
STORAGE_SAVE_ATTEMPTS=3              # upload attempts per call
STORAGE_RETRY_DELAY_MS=2000          # pause before the 2nd attempt (doubles each time)
STORAGE_SAVE_TIMEOUT_MS=15000        # give up on a single attempt after this long
STORAGE_OUTAGE_COOLDOWN_SEC=120      # after a failure, save new calls locally without retrying for this long
STORAGE_FALLBACK_DIR=audio/pending-upload
STORAGE_FALLBACK_MAX_MB=2048         # above this, calls are kept without audio instead of filling the disk
STORAGE_RETRY_INTERVAL_MIN=5         # how often the re-upload job runs

# Days to retain audio before automatic cleanup (0 = keep forever)
AUDIO_RETENTION_DAYS=30


#################################################################
##              GEOCODING & LOCATION SETTINGS                  ##
#################################################################
# Provide at least one geocoding provider.
# NOTE: keys are kept server-side and are no longer exposed to the browser.

GOOGLE_MAPS_API_KEY=
LOCATIONIQ_API_KEY=

GEOCODING_CITY=Silver Spring
GEOCODING_STATE=MD
GEOCODING_COUNTRY=US
GEOCODING_TARGET_COUNTIES=Montgomery County
TARGET_CITIES_LIST=

# Map default view (set automatically by the wizard's "use my location").
MAP_CENTER_LAT=
MAP_CENTER_LON=
MAP_DEFAULT_ZOOM=13


#################################################################
##                 TRANSCRIPTION SETTINGS                      ##
#################################################################

# Provider: local | remote | openai | icad
TRANSCRIPTION_MODE=local
PYTHON_COMMAND=python
AUTO_UPDATE_PYTHON_PACKAGES=false

# Transcription whitelist/blacklist. TrunkRecorder uploads every call (it can't
# pre-filter like SDRTrunk), so use this to control which talkgroups get
# transcribed. TRANSCRIBE_MODE: all | whitelist | blacklist.
#   whitelist  -> only transcribe talkgroups in TRANSCRIBE_TALK_GROUPS
#   blacklist  -> transcribe everything except those talkgroups
# Entries are talkgroup IDs (or system:id) separated by commas.
TRANSCRIBE_MODE=all
TRANSCRIBE_TALK_GROUPS=

# --- Local (faster-whisper) ---
# Compute device: cuda (NVIDIA GPU) | cpu | mps (Apple Silicon)
TRANSCRIPTION_DEVICE=cpu
WHISPER_MODEL=large-v3-turbo

# --- Remote Faster-Whisper ---
FASTER_WHISPER_SERVER_URL=http://127.0.0.1:9912

# --- ICAD ---
ICAD_URL=http://127.0.0.1:9912
ICAD_API_KEY=
ICAD_PROFILE=large

# --- OpenAI transcription ---
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TRANSCRIPTION_TEMPERATURE=0
OPENAI_TRANSCRIPTION_PROMPT=Scanner audio: police, fire, EMS radio communications. Transcribe addresses, unit numbers, and emergency details accurately; leave blank or garbled audio blank.

# --- Transcription quality (adapted from RadioTranscriber) ---
# Audio cleanup applied before ANY transcription mode. Produces a 16 kHz mono
# WAV. Tested on decoded P25 audio: high-pass alone helped; low-pass and
# percentile normalization dropped words / added hallucinations, so they are off.
AUDIO_PREPROCESS_ENABLED=true
AUDIO_PREPROCESS_HIGHPASS_HZ=100          # 0 = off; strips rumble/hum
AUDIO_PREPROCESS_LOWPASS_HZ=0             # 0 = off; e.g. 3500-4000 to cut hiss on analog FM
AUDIO_PREPROCESS_NORMALIZE_PERCENTILE=0   # 0 = off; RadioTranscriber uses 95 (clips loud samples)
AUDIO_PREPROCESS_NORMALIZE_TARGET=0.9     # level (0-1 of full scale) the percentile is scaled to
AUDIO_PREPROCESS_MAX_GAIN=20              # cap so near-silent clips aren't amplified into noise

# Hallucination filter applied to transcripts from ANY mode.
TRANSCRIPT_FILTER_ENABLED=true
TRANSCRIPT_FILTER_MAX_WORDS_PER_SEC=8     # discard text faster than humanly spoken; 0 = off
TRANSCRIPT_FILTER_CASCADE_MIN_REPEATS=4   # "copy copy copy copy" -> trimmed; 0 = off
TRANSCRIPT_FILTER_TONE_MARKERS=true       # "BEEEEP"/"AAAAAAA" -> [beeps], long letter runs -> [noise]
TRANSCRIPT_FILTER_REPEAT_BUSTER=false     # cut at any immediately repeated 3 words (dispatch repeats addresses, so off)
# Pipe-separated, case-insensitive. Leave unset to use the built-in lists.
# TRANSCRIPT_FILTER_BLOCK_PHRASES=CastingWords|Rev.com|amara.org|ESA, Inc.|U.S. Department of|Transcripts translated by|Transcription Outsourcing
# TRANSCRIPT_FILTER_CUTOFF_PHRASES=Thanks for watching|Thank you for watching|Stay tuned|Subtitles by|Captions by|Transcription by
# Optional feed-specific spoken-unit rewrites, "spoken=written" pairs separated by |
# TRANSCRIPT_UNIT_MAPPINGS=eight one=A1|five two eight one=52A1

# Local-mode (faster-whisper) decoding. Defaults shown preserve prior behaviour;
# RadioTranscriber uses beam 10-12, patience 1.5, temperature 0, no-speech 0.75.
WHISPER_BEAM_SIZE=3
WHISPER_PATIENCE=1.0
# WHISPER_TEMPERATURE: blank = faster-whisper fallback list; 0 = greedy, no fallback
WHISPER_TEMPERATURE=
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_SEGMENT_NO_SPEECH_DROP=0          # drop segments with no_speech_prob above this; 0 = off
WHISPER_VAD_FILTER=true
WHISPER_VAD_MIN_SILENCE_MS=750
WHISPER_RETRY_WITHOUT_VAD=true            # false = leave tone/noise-only clips empty instead of re-running without VAD

# Merged calls (several radios in one recording) are split per speaker and
# transcribed separately. Segments shorter than this (key-ups, kerchunks, or a
# source listed after the audio ends) are dropped; if fewer than two usable
# segments remain, the whole call is transcribed as one.
MERGED_CALL_MIN_SEGMENT_SEC=0.5
# false = transcribe merged calls as one recording (no per-speaker lines in
# Discord). TrunkRecorder's speaker positions don't line up exactly with the
# audio, so per-speaker pieces can split mid-word or mis-attribute speakers.
MERGED_CALL_SPLIT=true


#################################################################
##            AI ADDRESS EXTRACTION & SUMMARIES                ##
#################################################################

# AI Provider: ollama | openai
AI_PROVIDER=openai

# --- Ollama (local LLM) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- OpenAI (cloud LLM) ---
OPENAI_MODEL=gpt-4o-mini

# --- Address extraction tuning ---
# Max time (ms) to wait for the AI on a single extraction/verification call.
AI_EXTRACT_TIMEOUT_MS=30000
# Second-pass sanity check: after extracting an address, ask the AI again whether
# it truly matches the transcript (catches hallucinated/garbage plots). Costs one
# extra quick AI call per geocoded call. Set to false to disable.
AI_VERIFY_ADDRESS=true

# --- Summaries ---
SUMMARY_LOOKBACK_HOURS=1
ASK_AI_LOOKBACK_HOURS=8

# Optionally restrict the #dispatch-summary channel to specific talkgroups.
# When ENABLE_SUMMARY_TALK_GROUPS=true, only SUMMARY_TALK_GROUPS are summarized.
# Entries are talkgroup IDs (or system:id) separated by commas.
ENABLE_SUMMARY_TALK_GROUPS=false
SUMMARY_TALK_GROUPS=


#################################################################
##                 TALK GROUP MAPPINGS                         ##
#################################################################

ENABLE_MAPPED_TALK_GROUPS=true
MAPPED_TALK_GROUPS=

# Per-talkgroup town hints (added by the setup wizard), e.g.
# TALK_GROUP_4005=Silver Spring / Montgomery County MD


#################################################################
##              TWO-TONE DETECTION SETTINGS                    ##
#################################################################

ENABLE_TWO_TONE_MODE=false
TWO_TONE_TALK_GROUPS=
TWO_TONE_QUEUE_SIZE=1
TONE_DETECTION_TYPE=auto

# Minimum A-tone and B-tone lengths (seconds). TWO_TONE_MAX_TONE_LENGTH is the
# legacy name for the B-tone MINIMUM; TWO_TONE_B_MIN_LENGTH overrides it if set.
TWO_TONE_MIN_TONE_LENGTH=0.7
TWO_TONE_MAX_TONE_LENGTH=3.0
# TWO_TONE_B_MIN_LENGTH=2.6
# TWO_TONE_MAX_GAP_S=0.35                 # max silence between A and B tones
TWO_TONE_BW_HZ=50
TWO_TONE_MIN_PAIR_SEPARATION_HZ=100

PULSED_MIN_CYCLES=3
PULSED_MIN_ON_MS=50
PULSED_MAX_ON_MS=500
PULSED_MIN_OFF_MS=25
PULSED_MAX_OFF_MS=800
PULSED_BANDWIDTH_HZ=50

LONG_TONE_MIN_LENGTH=0.5
LONG_TONE_BANDWIDTH_HZ=75

# Hi-low warble (two alternating tones, e.g. HFD citywide alert ~812/1516 Hz).
# Off unless enabled; works with any TONE_DETECTION_TYPE.
TONE_DETECT_HI_LOW=false
HI_LOW_INTERVAL_S=0.2                     # max gap between alternating tones
HI_LOW_MIN_ALTERNATIONS=6                 # tone changes required (6 ~= 3 hi/low cycles)
HI_LOW_BANDWIDTH_HZ=25                    # allowed drift within each tone
HI_LOW_MIN_PAIR_SEPARATION_HZ=40          # how far apart the two tones must be

TONE_DETECTION_THRESHOLD=0.3
TONE_FREQUENCY_BAND=300,1500
TONE_TIME_RESOLUTION_MS=15


#################################################################
##                         LOGGING                             ##
#################################################################

# Logs go to logs/combined-YYYY-MM-DD.log and logs/error-YYYY-MM-DD.log,
# a new file each day. Files older than LOG_RETENTION_DAYS are deleted.
LOG_RETENTION_DAYS=3
# Optional per-file size cap (e.g. 50m, 1g); a day's log continues in a
# numbered file once it hits the cap. Blank = no cap.
LOG_MAX_SIZE=
# Console shows calls, addresses, tones, warnings and errors in one aligned
# layout; repeated errors within a minute are collapsed into a summary line.
# true = also show routine INFO (map polling, per-step processing), debug
# lines and stack traces. Log files always get everything.
LOG_CONSOLE_VERBOSE=false
# NO_COLOR=1 disables console colors.
